# Base URL of the OpenAI-compatible upstream API the proxy forwards to
UPSTREAM_BASE_URL=
# API key for the upstream API (never commit the real value; this file is the template)
UPSTREAM_API_KEY=
# Model name the proxy routes calls to
UPSTREAM_MODEL=
# Hard per-model-call token cap the proxy enforces before any dispatch
CAP_TOKENS=6000
# Local port the proxy listens on
PORT=8787
# Context-fitting strategy: hierarchy (default) or truncation
STRATEGY=hierarchy
# Maximum number of concurrent fleet sub-calls per request
CONCURRENCY=3
# Data directory for calibration, spill, and distillate state
DATA_DIR=.ctxh
# API key clients must present to use the proxy (empty disables proxy auth)
PROXY_API_KEY=
